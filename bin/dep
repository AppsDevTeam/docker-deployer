#!/bin/bash

# Runs Deployer from the appsdevteam/deployer image against the current project.
#
# The image tag comes from DEPLOYER_VERSION - set it in the project's .env to
# pick a different Deployer, e.g. DEPLOYER_VERSION=7 for Deployer 7 (its deploy
# scripts are not backwards compatible with 6.x). Defaults to the 6.x image.

if [ -z "$DEPLOYER_VERSION" ] && [ -f "$PWD/.env" ]; then
	DEPLOYER_VERSION=$(grep -E '^\s*DEPLOYER_VERSION\s*=' "$PWD/.env" | tail -n 1 | cut -d '=' -f 2- | tr -d '"'"'"' \r')
fi

IMAGE="appsdevteam/deployer:${DEPLOYER_VERSION:-latest}"

# SSH: privátní klíče do kontejneru nejdou, když je umí podepsat ssh-agent. Deployer běží pod
# rootem a spouští deploy.php projektu i recept z jeho vendor/ - kód závislostí by jinak klíče
# přečetl. Kontejner dostane socket agenta (klíč jde použít jen po dobu běhu, ne zkopírovat)
# a z ~/.ssh jen config a known_hosts, pro čtení. Na macOS je agent hostu v kontejneru na
# /run/host-services/ssh-auth.sock (Docker Desktop), na Linuxu se montuje socket z SSH_AUTH_SOCK.
# Bez klíče v agentovi se namontuje jen jeden soubor klíče (DEP_SSH_KEY, jinak ~/.ssh/id_ed25519 -
# tam ho dává adt/ci), pro čtení: v CI (CI=true) vždy, mimo CI jen s výslovně nastaveným DEP_SSH_KEY,
# jinak dep skončí chybou - dřív se montovaly všechny ~/.ssh/id_* a root v kontejneru je četl.
# Jednotlivé soubory, ne adresář: /root/.ssh je v image VOLUME a ssh tam zakládá jen svoje věci.
SSH_OPTS=()
if [ "$(uname)" = "Darwin" ]; then
    SSH_OPTS+=(-v /run/host-services/ssh-auth.sock:/ssh-agent -e SSH_AUTH_SOCK=/ssh-agent)
elif [ -n "$SSH_AUTH_SOCK" ] && [ -S "$SSH_AUTH_SOCK" ]; then
    SSH_OPTS+=(-v "$SSH_AUTH_SOCK:/ssh-agent" -e SSH_AUTH_SOCK=/ssh-agent)
fi
for f in config known_hosts; do
    [ -f "$HOME/.ssh/$f" ] && SSH_OPTS+=(-v "$HOME/.ssh/$f:/root/.ssh/$f:ro")
done
if ! ssh-add -l >/dev/null 2>&1; then
    if [ -z "$DEP_SSH_KEY" ] && [ "$CI" != "true" ]; then
        echo "dep: ssh-agent nemá žádný klíč. Přidej ho: ssh-add ~/.ssh/id_ed25519 (macOS: ssh-add --apple-use-keychain ~/.ssh/id_ed25519)." >&2
        echo "     Bez agenta jen výslovně: DEP_SSH_KEY=~/.ssh/<klíč> (namontuje se jen ten, pro čtení, do kontejneru běžícího pod rootem)." >&2
        exit 1
    fi
    key="${DEP_SSH_KEY:-$HOME/.ssh/id_ed25519}"
    if [ ! -f "$key" ]; then
        echo "dep: ssh-agent nemá žádný klíč a soubor klíče $key neexistuje (DEP_SSH_KEY)." >&2
        exit 1
    fi
    echo "dep: ssh-agent nemá žádný klíč - montuji jen $key (pro čtení)." >&2
    SSH_OPTS+=(-v "$key:/root/.ssh/$(basename "$key"):ro")
fi

test -t 0 && USE_TTY="-t"

docker run --rm -i ${USE_TTY:+"$USE_TTY"} "${SSH_OPTS[@]}" \
    -v "$(realpath "$PWD")":/project \
    --network host \
  "$IMAGE" "$@"
